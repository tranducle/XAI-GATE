figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white
savefig.edgecolor: white
savefig.bbox: tight
savefig.pad_inches: 0.04
savefig.dpi: 220

axes.edgecolor: "#D8D1C7"
axes.labelcolor: "#4B5563"
axes.linewidth: 0.8
axes.grid: True
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False
axes.titlelocation: left
axes.titlesize: 10.5
axes.labelsize: 9.5
axes.xmargin: 0.03
axes.ymargin: 0.05

grid.color: "#E7E5E4"
grid.linewidth: 0.55
grid.linestyle: -
grid.alpha: 0.58

font.size: 9
font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial, Liberation Sans

xtick.color: "#6B7280"
ytick.color: "#6B7280"
xtick.labelsize: 8
ytick.labelsize: 8
xtick.major.size: 3
ytick.major.size: 3
xtick.major.width: 0.8
ytick.major.width: 0.8

legend.frameon: False
legend.fontsize: 8
legend.title_fontsize: 8
legend.borderaxespad: 0.35
legend.handlelength: 1.5

lines.linewidth: 1.7
lines.markersize: 4.0
patch.linewidth: 0.0
errorbar.capsize: 2.2

pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
